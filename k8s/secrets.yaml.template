# Rhizome secrets template.
# Copy to secrets.yaml, fill in real values, then apply:
#   kubectl apply -f k8s/secrets.yaml
#
# NEVER commit secrets.yaml to git — it is in .gitignore.
# Generate keys with:
#   openssl rand -hex 32   (DATABASE_URL password, etc.)

apiVersion: v1
kind: Secret
metadata:
  name: rhizome-secrets
  namespace: default
type: Opaque
stringData:
  # Postgres — uses rhizome schema; note the search_path option
  DATABASE_URL: "postgresql+psycopg2://postgres:CHANGEME@postgres-svc:5432/postgres?options=-csearch_path%3Drhizome"

  # LLM provider keys — at least one required
  GOOGLE_API_KEY: ""
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""

  # Model selection
  RHIZOME_MODEL: "gemini-2.5-flash"
  RHIZOME_MODEL_PROVIDER: "google_genai"
  RHIZOME_TRIAGE_MODEL: "gemini-2.5-flash"
