# LLM provider keys — set whichever providers you want to use
# At least one is required to run the CLI; GOOGLE_API_KEY is the default provider
GOOGLE_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Model selection — optional, defaults shown per provider
# RHIZOME_MODEL_PROVIDER=google_genai   # google_genai | openai | anthropic
# RHIZOME_MODEL=gemini-2.5-flash        # provider default used if unset
# RHIZOME_TRIAGE_MODEL=gemini-2.5-flash # falls back to RHIZOME_MODEL if unset

# Telemetry — optional
# RHIZOME_OTEL_ENABLED=1
# RHIZOME_OTEL_EXPORTER=console
# RHIZOME_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# RHIZOME_OTEL_SERVICE_NAME=rhizome
