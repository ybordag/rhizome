# LLM provider — required
GOOGLE_API_KEY=your_gemini_key_here

# Model selection — optional, defaults shown
# RHIZOME_MODEL=gemini-2.0-flash
# RHIZOME_MODEL_PROVIDER=google_genai
# RHIZOME_TRIAGE_MODEL=gemini-2.0-flash

# Phase 2: additional provider keys (uncomment when switching providers)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Telemetry — optional
# RHIZOME_OTEL_ENABLED=1
# RHIZOME_OTEL_EXPORTER=console
# RHIZOME_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# RHIZOME_OTEL_SERVICE_NAME=rhizome
